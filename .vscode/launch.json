            "program": "${workspaceFolder}/.docker/gptresearcher/pipeline/queueserver/src/test.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ROOT_DIR": "${workspaceFolder}",
                "LOGGING_LEVEL": "DEBUG",
                "QUEUE_SERVER_DOMAIN": "localhost:8001",
                "GPTRESEARCHER_DOMAIN": "192.168.2.200:9177",
