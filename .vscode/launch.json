{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GPTResearchQueueServer",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.docker/gptresearcher/pipeline/queueserver/src/.venv/Scripts/python.exe",
            "program": "${workspaceFolder}/.docker/gptresearcher/pipeline/queueserver/src/service.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ROOT_DIR": "${workspaceFolder}",
                "LOGGING_LEVEL": "DEBUG",
                "GPTRESEARCHER_WS_URL": "ws://192.168.2.200:9177/ws",
                "MAX_CONCURRENT_RESEARCH": "1",
                "VERSION": "dev"
            }
        },
        {
            "name": "Test: GPTResearchQueueServer",
            "type": "debugpy",
            "request": "launch",
